# APP Configuration
APP_NAME=bpjs-framework
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/
APP_LOCALE=id

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpjs
DB_USERNAME=root
DB_PASSWORD=

# Database Pool
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_IDLE_TIMEOUT=60

# Query Logging
DB_QUERY_LOG=false
DB_SLOW_QUERY=1000

# Replica Database untuk read-only
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=3306
DB_REPLICA_USERNAME=root
DB_REPLICA_PASSWORD=

# Queue Configuration
QUEUE_ENGINE=database
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_AFTER=90
QUEUE_SLEEP=2
QUEUE_TRIES=3
QUEUE_MEMORY=128
QUEUE_KEEPALIVE=300

JWT_SECRET=yoursecretkey
CRYPTO_KEY=yourkey

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=file

TIMEZONE=Asia/Jakarta

# SMTP CONFIGURATION
SMTP_HOST=smtp.app.com
SMTP_AUTH=true
SMTP_EMAIL=youremail@example.com
SMTP_PASSWORD=yourpassword
SMTP_SECURE=tls
SMTP_PORT=

API_DATA=
API_KEY=